<Project Sdk="Microsoft.NET.Sdk">

  <!-- WinForms 快速上手：JSON 点表、虚拟 Modbus 与控件绑定。 -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>Zeus.Samples.WinForms.QuickStart</RootNamespace>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Zeus.Communications\Zeus.Communications.csproj" />
    <ProjectReference Include="..\..\src\Zeus.Configuration\Zeus.Configuration.csproj" />
    <ProjectReference Include="..\..\src\Zeus.Presentation.WinForms\Zeus.Presentation.WinForms.csproj" />
    <ProjectReference Include="..\..\src\Zeus.Protocols.Modbus\Zeus.Protocols.Modbus.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="zeus.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
