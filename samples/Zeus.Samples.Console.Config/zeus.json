{
  "$schema": "https://docs.greekmythology.cn/schemas/zeus.json",
  "acquisition": {
    "intervalMilliseconds": 200,
    "pollImmediately": true
  },
  "channels": [
    {
      "name": "bus",
      "type": "virtual",
      "options": {
        "responder": "modbus",
        "unitId": 1,
        "transport": "rtu"
      }
    }
  ],
  "devices": [
    {
      "name": "oven",
      "channel": "bus",
      "type": "modbus-rtu",
      "points": [
        {
          "name": "temperature",
          "options": {
            "table": "holding",
            "address": 0,
            "scale": 0.1
          }
        },
        {
          "name": "setpoint",
          "options": {
            "table": "holding",
            "address": 1,
            "scale": 0.1,
            "writable": true
          }
        },
        {
          "name": "heater",
          "options": {
            "table": "coil",
            "address": 2,
            "writable": true
          }
        }
      ],
      "options": {
        "unitId": 1
      }
    }
  ]
}

