<Project Sdk="Microsoft.NET.Sdk">

  <!-- OPC UA 客户端、NodeId 点表与内存虚拟 Server。协议只依赖通道抽象，TCP/虚拟通道由 Communications 提供。 -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>Zeus</RootNamespace>
    <AssemblyName>Zeus.Protocols.OpcUa</AssemblyName>
    <Description>Zeus OPC UA 客户端、NodeId 点表与内存虚拟 Server。当前支持 opc.tcp、SecurityPolicy None、会话与 Value 读写。</Description>
    <PackageDescription>Zeus OPC UA 客户端、NodeId 点表与内存虚拟 Server。当前支持 opc.tcp、SecurityPolicy None、会话与 Value 读写。</PackageDescription>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Zeus.Abstractions\Zeus.Abstractions.csproj" />
    <ProjectReference Include="..\Zeus.Configuration\Zeus.Configuration.csproj" />
    <ProjectReference Include="..\Zeus.Core\Zeus.Core.csproj" />
    <ProjectReference Include="..\Zeus.Hosting\Zeus.Hosting.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="8.0.2" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="8.0.2" />
  </ItemGroup>

</Project>
