{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://docs.greekmythology.cn/schemas/zeus.json",
  "title": "Zeus JSON 工程配置",
  "description": "Zeus 通道、设备、点表、采集与重连配置。通道类型、协议和点位参数统一写入 options。",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string",
      "description": "JSON Schema 地址，建议固定为 https://docs.greekmythology.cn/schemas/zeus.json。"
    },
    "acquisition": { "$ref": "#/$defs/acquisition" },
    "reconnect": { "$ref": "#/$defs/reconnect" },
    "channels": {
      "type": "array",
      "description": "传输通道列表。",
      "items": { "$ref": "#/$defs/channel" },
      "default": []
    },
    "devices": {
      "type": "array",
      "description": "设备列表；device.channel 必须引用 channels 中声明的通道名。",
      "items": { "$ref": "#/$defs/device" },
      "default": []
    }
  },
  "$defs": {
    "name": {
      "type": "string",
      "minLength": 1,
      "description": "Zeus 内部名称，建议只使用英文、数字、下划线和短横线。"
    },
    "address": {
      "oneOf": [
        { "type": "integer", "minimum": 0 },
        { "type": "string", "pattern": "^(0x[0-9a-fA-F]+|[0-9]+)$" }
      ],
      "description": "0 基地址；也可写十六进制字符串，例如 \"0x10\"。"
    },
    "acquisition": {
      "type": "object",
      "additionalProperties": false,
      "description": "周期采集配置。",
      "properties": {
        "intervalMilliseconds": { "type": "integer", "minimum": 1, "default": 500 },
        "pollImmediately": { "type": "boolean", "default": true },
        "sourceTimeoutMilliseconds": { "type": "integer", "minimum": 0, "default": 0 },
        "serializePerChannel": { "type": "boolean", "default": true }
      }
    },
    "reconnect": {
      "type": "object",
      "additionalProperties": false,
      "description": "通道故障后的自动重连配置。",
      "properties": {
        "enabled": { "type": "boolean", "default": true },
        "initialDelayMilliseconds": { "type": "integer", "minimum": 0, "default": 1000 },
        "maxDelayMilliseconds": { "type": "integer", "minimum": 0, "default": 30000 },
        "backoffMultiplier": { "type": "number", "minimum": 1, "default": 2 },
        "maxAttempts": { "type": "integer", "minimum": 0, "default": 0 },
        "jitterRatio": { "type": "number", "minimum": 0, "default": 0 },
        "circuitBreakMilliseconds": { "type": "integer", "minimum": 0, "default": 0 }
      }
    },
    "channelOptions": {
      "type": "object",
      "additionalProperties": true,
      "default": {},
      "description": "通道类型和虚拟从站专属选项。",
      "properties": {
        "portName": { "type": "string", "description": "串口名，例如 COM3。" },
        "baudRate": { "type": "integer", "minimum": 1, "default": 115200 },
        "host": { "type": "string", "description": "TCP/UDP 客户端对端主机。" },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535, "default": 502 },
        "localAddress": { "type": "string", "description": "TCP/UDP 服务端本地监听地址，例如 0.0.0.0。" },
        "localPort": { "type": "integer", "minimum": 0, "maximum": 65535, "default": 0 },
        "responder": {
          "type": "string",
          "enum": [ "modbus", "mc", "s7", "fins", "host-link", "mewtocol", "ethernet-ip", "dlt645", "iec104", "mqtt", "snmp" ]
        },
        "unitId": { "type": "integer", "minimum": 0, "maximum": 255, "default": 1 },
        "transport": { "type": "string", "enum": [ "rtu", "tcp", "ascii", "udp" ], "default": "rtu" },
        "meterAddress": { "type": "string", "pattern": "^[0-9]{12}$", "default": "000000000001" },
        "commonAddress": { "type": "integer", "minimum": 0, "default": 1 },
        "snmpCommunity": { "type": "string", "default": "public" },
        "snmpWriteCommunity": { "type": "string" }
      }
    },
    "deviceOptions": {
      "type": "object",
      "additionalProperties": true,
      "default": {},
      "description": "设备协议专属选项。",
      "properties": {
        "transport": { "type": "string", "enum": [ "", "udp", "tcp" ], "default": "" },
        "unitId": { "type": "integer", "minimum": 0, "maximum": 255, "default": 1 },
        "timeoutMilliseconds": { "type": "integer", "minimum": 1 },
        "frameType": { "type": "string", "enum": [ "1e", "3e", "4e" ], "default": "3e" },
        "encoding": { "type": "string", "enum": [ "binary", "ascii" ], "default": "binary" },
        "networkNumber": { "type": "integer", "minimum": 0, "default": 0 },
        "pcNumber": { "type": "integer", "minimum": 0, "default": 255 },
        "ioNumber": { "type": "integer", "minimum": 0, "default": 1023 },
        "stationNumber": { "type": "integer", "minimum": 0, "default": 0 },
        "monitoringTimer": { "type": "integer", "minimum": 0, "default": 16 },
        "serialNumber": { "type": "integer", "minimum": 0, "default": 0 },
        "rack": { "type": "integer", "minimum": 0, "default": 0 },
        "slot": { "type": "integer", "minimum": 0, "default": 1 },
        "localTsap": { "type": "integer", "minimum": 0, "default": 256 },
        "remoteTsap": { "type": "integer", "minimum": 0 },
        "requestedPduLength": { "type": "integer", "minimum": 1, "default": 480 },
        "destinationNetwork": { "type": "integer", "minimum": 0, "default": 0 },
        "destinationNode": { "type": "integer", "minimum": 0, "default": 0 },
        "destinationUnit": { "type": "integer", "minimum": 0, "default": 0 },
        "sourceNetwork": { "type": "integer", "minimum": 0, "default": 0 },
        "sourceNode": { "type": "integer", "minimum": 0, "default": 0 },
        "sourceUnit": { "type": "integer", "minimum": 0, "default": 0 },
        "gatewayCount": { "type": "integer", "minimum": 0, "default": 2 },
        "informationControlField": { "type": "integer", "minimum": 0, "default": 128 },
        "tcpRequestedClientNode": { "type": "integer", "minimum": 0, "default": 0 },
        "useTcpNodeAddressHandshake": { "type": "boolean", "default": true },
        "wordOrder": { "type": "string", "enum": [ "high-word-first", "low-word-first" ], "default": "high-word-first" },
        "meterAddress": { "type": "string", "pattern": "^[0-9]{12}$", "default": "000000000001" },
        "password": { "type": "string", "pattern": "^[0-9]{8}$", "default": "00000000" },
        "operatorCode": { "type": "string", "pattern": "^[0-9]{8}$", "default": "00000000" },
        "wakeUpPreambleCount": { "type": "integer", "minimum": 0, "default": 4 },
        "commonAddress": { "type": "integer", "minimum": 0, "default": 1 },
        "originatorAddress": { "type": "integer", "minimum": 0, "default": 0 },
        "interrogationQualifier": { "type": "integer", "minimum": 0, "default": 20 },
        "t1Milliseconds": { "type": "integer", "minimum": 0, "default": 15000 },
        "t2Milliseconds": { "type": "integer", "minimum": 0, "default": 10000 },
        "t3Milliseconds": { "type": "integer", "minimum": 0, "default": 20000 },
        "maxUnacknowledgedIFrames": { "type": "integer", "minimum": 1, "default": 12 },
        "acknowledgeWindow": { "type": "integer", "minimum": 1, "default": 8 },
        "mqttClientId": { "type": "string" },
        "mqttUsername": { "type": "string" },
        "mqttPassword": { "type": "string" },
        "mqttKeepAliveSeconds": { "type": "integer", "minimum": 0, "default": 60 },
        "mqttCleanSession": { "type": "boolean", "default": true },
        "mqttWillTopic": { "type": "string" },
        "mqttWillPayload": { "type": "string" },
        "mqttWillQos": { "type": "string", "enum": [ "0", "1", "2" ], "default": "0" },
        "mqttWillRetain": { "type": "boolean", "default": false },
        "mqttMaximumPacketSize": { "type": "integer", "minimum": 1, "default": 1048576 },
        "mqttAutomaticKeepAlive": { "type": "boolean", "default": true },
        "mqttAutomaticReconnect": { "type": "boolean", "default": true },
        "snmpCommunity": { "type": "string", "default": "public" },
        "snmpWriteCommunity": { "type": "string" },
        "snmpInitialRequestId": { "type": "integer", "minimum": 1, "default": 1 }
      }
    },
    "pointOptions": {
      "type": "object",
      "additionalProperties": true,
      "default": {},
      "description": "点位地址、数据类型、缩放、报警和写权限选项。",
      "properties": {
        "topic": { "type": "string" },
        "oid": { "type": "string", "pattern": "^[0-9]+(\\.[0-9]+)+$" },
        "mqttQos": { "type": "string", "enum": [ "0", "1", "2" ], "default": "0" },
        "mqttRetain": { "type": "boolean", "default": true },
        "tag": { "type": "string" },
        "table": { "type": "string", "enum": [ "holding", "input", "coil", "discrete" ], "default": "holding" },
        "deviceCode": { "type": "string", "enum": [ "D", "M", "X", "Y", "W", "R", "ZR" ] },
        "address": { "$ref": "#/$defs/address" },
        "area": {
          "type": "string",
          "enum": [ "db", "m", "i", "q", "cio", "wr", "hr", "ar", "dm", "tc", "em", "em0", "em1", "em2", "em3", "em4", "em5", "em6", "em7", "em8", "em9", "em10", "em11", "em12", "em13", "em14", "em15", "em16", "em17", "em18", "lr", "dt", "ld", "fl", "x", "y", "r", "l" ]
        },
        "db": { "type": "integer", "minimum": 0, "default": 0 },
        "bit": { "type": "integer", "minimum": 0, "maximum": 15, "default": 0 },
        "dataType": {
          "type": "string",
          "enum": [ "word", "bool", "byte", "dword", "int", "int16", "uint32", "int32", "dint", "real", "bit", "sint", "lint", "usint", "uint", "udint", "ulint", "lreal", "bcd", "raw", "single-point", "normalized", "scaled", "short-float", "text", "boolean", "int64", "double", "bytes", "integer", "gauge32", "counter32", "timeticks", "octet-string", "oid", "ip-address" ],
          "default": "word"
        },
        "dataLength": { "type": "integer", "minimum": 1, "default": 4 },
        "scale": { "type": "number" },
        "signed": { "type": "boolean", "default": false },
        "lowAlarmLimit": { "type": "number" },
        "highAlarmLimit": { "type": "number" },
        "deadband": { "type": "number", "minimum": 0, "default": 0 },
        "alarmSeverity": { "type": "string", "enum": [ "info", "warning", "alarm", "critical" ], "default": "warning" },
        "alarmArea": { "type": "string" },
        "alarmAssignee": { "type": "string" },
        "writable": { "type": "boolean", "default": false }
      }
    },
    "channel": {
      "type": "object",
      "additionalProperties": false,
      "required": [ "name", "type" ],
      "allOf": [
        { "if": { "properties": { "type": { "const": "serial" } }, "required": [ "type" ] }, "then": { "required": [ "options" ], "properties": { "options": { "required": [ "portName" ] } } } },
        { "if": { "properties": { "type": { "const": "tcp" } }, "required": [ "type" ] }, "then": { "required": [ "options" ], "properties": { "options": { "required": [ "host", "port" ] } } } },
        { "if": { "properties": { "type": { "const": "udp" } }, "required": [ "type" ] }, "then": { "required": [ "options" ], "properties": { "options": { "required": [ "host", "port" ] } } } },
        { "if": { "properties": { "type": { "const": "tcp-server" } }, "required": [ "type" ] }, "then": { "required": [ "options" ], "properties": { "options": { "required": [ "localPort" ] } } } },
        { "if": { "properties": { "type": { "const": "udp-server" } }, "required": [ "type" ] }, "then": { "required": [ "options" ], "properties": { "options": { "required": [ "localPort" ] } } } }
      ],
      "properties": {
        "name": { "$ref": "#/$defs/name" },
        "type": { "type": "string", "enum": [ "virtual", "serial", "tcp", "tcp-server", "udp", "udp-server" ], "default": "virtual" },
        "startup": { "type": "string", "enum": [ "required", "optional", "degraded", "degraded-allowed" ], "default": "required" },
        "options": { "$ref": "#/$defs/channelOptions" }
      }
    },
    "device": {
      "type": "object",
      "additionalProperties": false,
      "required": [ "name", "channel", "type" ],
      "properties": {
        "name": { "$ref": "#/$defs/name" },
        "channel": { "$ref": "#/$defs/name" },
        "type": { "type": "string", "enum": [ "modbus-rtu", "modbus-tcp", "modbus-ascii", "mitsubishi-mc", "siemens-s7", "omron-fins", "omron-host-link", "panasonic-mewtocol", "ethernet-ip", "dlt645", "iec104", "mqtt", "snmp" ], "default": "modbus-rtu" },
        "options": { "$ref": "#/$defs/deviceOptions" },
        "points": { "type": "array", "items": { "$ref": "#/$defs/point" }, "default": [] }
      }
    },
    "point": {
      "type": "object",
      "additionalProperties": false,
      "required": [ "name" ],
      "not": {
        "properties": {
          "options": {
            "required": [ "table", "writable" ],
            "properties": {
              "table": { "enum": [ "input", "discrete" ] },
              "writable": { "const": true }
            }
          }
        }
      },
      "properties": {
        "name": { "$ref": "#/$defs/name" },
        "options": { "$ref": "#/$defs/pointOptions" }
      }
    }
  }
}
