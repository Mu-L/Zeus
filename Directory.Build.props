<Project>
  <!--
    解决方案级编译约定。
    统一可空引用、文档生成与程序集元数据，避免各项目各自漂移。
  -->
  <PropertyGroup>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <Authors>Zeus Contributors</Authors>
    <Company>Zeus</Company>
    <Product>Zeus</Product>
    <Description>面向 .NET 的 UI 无关上位机开发框架。把复杂留给 Zeus，把简单留给用户。</Description>
    <Copyright>Copyright © Zeus</Copyright>
    <Version>0.20.1</Version>
    <NeutralLanguage>zh-Hans</NeutralLanguage>
    <IsPackable>false</IsPackable>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <PackageTags>zeus;host;modbus;mitsubishi;mc;siemens;s7;omron;fins;host-link;panasonic;mewtocol;ethernet-ip;cip;allen-bradley;dlt645;iec104;iec-60870-5-104;mqtt;mqtt311;snmp;snmpv2c;opcua;opc-ua;message-queue;electric-meter;serial;tcp;udp;winforms;wpf;industrial;scada</PackageTags>
    <PackageReleaseNotes>0.20.1：修复取消与协议超时区分、运行期拓扑回滚、报警搁置/解除抑制、点表时间戳刷新、通道/点表/报警/注册表/重连事件隔离与 TCP 服务端广播取消语义。</PackageReleaseNotes>
    <PackageProjectUrl>https://github.com/Mokode-dev/Zeus</PackageProjectUrl>
    <RepositoryUrl>https://github.com/Mokode-dev/Zeus</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
  </PropertyGroup>
</Project>
